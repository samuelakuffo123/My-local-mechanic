# MechNow deployment
# Local development: npm run api + npm run dev.
# Leave DATABASE_URL unset locally to use SQLite (.data/mechnow.sqlite).
VITE_MAPBOX_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=

# Production (Neon Postgres). Pooled URL for traffic, direct URL for migrations.
# DATABASE_URL=postgresql://user:pass@host-pooler.region.neon.tech/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host.region.neon.tech/db?sslmode=require

# Other Neon services declared in neon.ts. `neon env pull` writes real values
# into .env after `neon deploy`; copy them into the host's secrets if needed.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_FUNCTION_HOST_SUFFIX=
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=

# Production hosting (see docs/DEPLOYMENT.md). Render's render.yaml sets these.
# NODE_ENV=production
# API_HOST=0.0.0.0
# API_PORT=10000
# PUBLIC_ORIGIN=https://your-app.example.com
# CORS_ORIGINS=https://your-app.example.com
# TRUST_PROXY=true
# ADMIN_PHONE=
# ADMIN_PASSWORD=
# PAYMENTS_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# SMS_PROVIDER=
